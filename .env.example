# ==========================================
# LearnAI — AI-Powered Personalized Learning Path Recommender
# Project-Wide Environment Template (.env.example)
# ==========================================

# ------------------------------------------
# 1. Database Configuration (Supabase PostgreSQL / Local)
# ------------------------------------------
DB_URL=jdbc:postgresql://your-supabase-host:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=postgres

# ------------------------------------------
# 2. JWT Security Configuration
# ------------------------------------------
# Generate a secure 256-bit key: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# ------------------------------------------
# 3. Google Gemini AI Mentorship & Reasoning
# ------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=10

# ------------------------------------------
# 4. Python ML Recommendation Microservice
# ------------------------------------------
ML_SERVICE_URL=http://localhost:8000

# ------------------------------------------
# 5. Spring Boot Server Port & CORS
# ------------------------------------------
SERVER_PORT=8080

# ------------------------------------------
# 6. Email & OTP Verification (Gmail SMTP / Custom SMTP)
# ------------------------------------------
# For Gmail SMTP:
#   1. Enable 2-Factor Authentication on your Google Account.
#   2. Go to Google Account Security -> App Passwords.
#   3. Create an App Password for 'LearnAI' and paste the 16-character code below.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# ------------------------------------------
# 7. OTP Security & Rate Limiting Controls
# ------------------------------------------
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Set to true only in local development to print OTP codes to console
OTP_DEV_LOGGING=false